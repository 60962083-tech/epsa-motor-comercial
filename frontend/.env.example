# Copia este archivo como .env (NO lo subas a Git) y completa los 3 valores.
# Si falta alguno, la web funciona en MODO DEMOSTRACIÓN con datos locales.

# URL donde está publicada la API de Michelle (hoy en local: http://localhost:3000)
VITE_API_URL=http://localhost:3000

# Proyecto de Supabase (Settings > API). Usa SOLO la clave "anon"; nunca la service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon
