# Copia este archivo como .env (NO lo subas a Git) y completa los valores.
# Si falta alguno, la web funciona en MODO DEMOSTRACIÓN con datos locales.

# Proyecto de Supabase (los mismos dos valores del .env de la API de Michelle).
# Usa SOLO la clave "anon"; nunca la service_role.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon

# Dirección de la API de Michelle (en tu computadora: http://localhost:3000)
VITE_API_URL=http://localhost:3000

# También se aceptan VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY.
