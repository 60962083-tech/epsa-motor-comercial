# Clave pública (anon) de Supabase. Si ya tienes el .env de la raíz del repositorio (el de la API), no hace falta.
# Copia este archivo como frontend/.env (no se sube a GitHub). Nunca pongas la clave service_role.
SUPABASE_ANON_KEY=

# Opcional: otra dirección de la API
# VITE_API_URL=https://epsa-motor-api.onrender.com

# Opcional: probar con la API corriendo en tu computadora (sin esta línea se usa la de Render)
# EPSA_API_LOCAL=1
# VITE_API_URL=http://localhost:3000
