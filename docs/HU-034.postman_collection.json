{
  "info": {
    "name": "EPSA HU-034 Compras pendientes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "supabase_url",
      "value": "https://TU-PROYECTO.supabase.co"
    },
    {
      "key": "supabase_anon_key",
      "value": ""
    },
    {
      "key": "email",
      "value": "gerente@epsamotor.test"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "codmod",
      "value": "1"
    },
    {
      "key": "colcom",
      "value": "Azul"
    },
    {
      "key": "cancom",
      "value": "3"
    },
    {
      "key": "idempotencia",
      "value": ""
    },
    {
      "key": "codcom",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Iniciar sesión",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{supabase_anon_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{supabase_url}}/auth/v1/token?grant_type=password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sesión válida', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('access_token', pm.response.json().access_token || '');"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Revisar pendientes antes de registrar respaldo",
      "request": {
        "method": "GET",
        "url": "{{api_url}}/api/compras?limite=50&offset=0"
      }
    },
    {
      "name": "3. Registrar o reintentar la misma compra",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencia}}"
          }
        ],
        "url": "{{api_url}}/api/compras",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codmod\": \"{{codmod}}\",\n  \"colcom\": \"{{colcom}}\",\n  \"cancom\": {{cancom}}\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Conservar la clave en reintentos. Vaciarla manualmente solo para una compra distinta.",
              "if (!pm.collectionVariables.get('idempotencia')) pm.collectionVariables.set('idempotencia', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if ([200,201].includes(pm.response.code)) pm.collectionVariables.set('codcom', pm.response.json().data.codcom);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Consultar misma compra para continuar HU-002",
      "request": {
        "method": "GET",
        "url": "{{api_url}}/api/compras/{{codcom}}"
      }
    }
  ]
}
